# ── Daily email notifications (Resend) ──────────────────────────────────────
# Resend API key. Without a valid "re_..." key the endpoints still work but no
# mail is sent (rows are created, sends are skipped and logged).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified Resend sender. Branding is Puzzle Page, so use a verified
# puzzlepage.app address; only the email SUBJECT lines speak as HUEMAN.
RESEND_FROM_EMAIL=daily@puzzlepage.app
RESEND_FROM_NAME=PuzzlePage Daily

# Local hour (0–23, default 8) at which each subscriber receives the day's
# puzzle, in THEIR OWN time zone. The send is driven by an hourly GitHub Actions
# workflow (.github/workflows/daily-email.yml); the endpoint emails each
# subscriber once their local clock reaches this hour. Set to 0 to email
# everyone at the 00:00 UTC drop instead.
EMAIL_SEND_HOUR=8

# Secret that authorizes /api/cron/daily-send. The GitHub Actions workflow sends
# it as "Authorization: Bearer $CRON_SECRET" — add the SAME value as a GitHub
# repo secret (Settings → Secrets and variables → Actions). If unset, the
# endpoint runs unauthenticated (fine for first deploy; set it before going live).
CRON_SECRET=replace-with-a-long-random-string

# ── Database (already provisioned via the Vercel Neon integration) ───────────
# DATABASE_URL / POSTGRES_URL are injected by the integration; see api/_lib/db.ts
