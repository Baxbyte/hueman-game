# ── Daily email notifications (Resend) ──────────────────────────────────────
# Resend API key. Without a valid "re_..." key the endpoints still work but no
# mail is sent (rows are created, sends are skipped and logged).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified Resend sender. Branding is Puzzle Page, so use a verified
# puzzlepage.app address; only the email SUBJECT lines speak as HUEMAN.
RESEND_FROM_EMAIL=daily@puzzlepage.app
RESEND_FROM_NAME=PuzzlePage Daily

# Local hour (0–23) at which each subscriber receives the day's puzzle, in their
# own time zone. Default 8 (8am local). The hourly cron matches on this.
EMAIL_SEND_HOUR=8

# Secret that authorizes the /api/cron/daily-send job. Vercel Cron sends it as
# "Authorization: Bearer $CRON_SECRET". If unset, the cron runs unauthenticated
# (fine for first deploy; set it before going live).
CRON_SECRET=replace-with-a-long-random-string

# ── Database (already provisioned via the Vercel Neon integration) ───────────
# DATABASE_URL / POSTGRES_URL are injected by the integration; see api/_lib/db.ts
