{
  "name": "hueman-game",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:schema && npm run test:seed && npm run test:signatures",
    "test:schema": "node test/schema.test.mjs .",
    "test:seed": "node --experimental-strip-types --import ./test/ts-resolve.mjs test/seed.test.mjs",
    "test:signatures": "node --experimental-strip-types test/signatures.test.mjs",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --lib es2023,dom --skipLibCheck api/*.ts api/_lib/*.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.6.5",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@vercel/node": "^5.8.17"
  }
}
